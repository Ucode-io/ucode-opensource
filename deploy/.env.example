# Local development defaults. Everything here is throwaway: this file is meant
# to work as-is on a laptop and must never carry a real credential.
#
# The stack binds to 127.0.0.1 only.

# ---------------------------------------------------------------- Postgres --
# The superuser needs CREATEDB and CREATEROLE: every ucode project gets its own
# database and role, created on this server at runtime.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ucode
POSTGRES_PASSWORD=ucode_local_dev
POSTGRES_MAX_CONNECTIONS=20

# ------------------------------------------------------------------- Redis --
GET_REQUEST_REDIS_HOST=redis
GET_REQUEST_REDIS_PORT=6379
GET_REQUEST_REDIS_PASSWORD=
GET_REQUEST_REDIS_DATABASE=0

# ------------------------------------------------------------------- MinIO --
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=ucode
MINIO_SECRET_KEY=ucode_local_dev
MINIO_SSL=false
MINIO_USE_SSL=false
MINIO_PROTOCOL=false
MINIO_BUCKET=ucode
MINIO_FOLDER=files

# ------------------------------------------------------------------ Secrets --
# company-service reads project database passwords through a secrets backend.
# Vault is the production choice; locally the Redis-backed provider needs no
# extra service beyond the Redis above.
SECRETS_PROVIDER=redis
VAULT_MOUNT_PATH=ucode
VAULT_SECRET_PATH=local

# Signs every JWT. The CLI generates one per installation; if you are running
# compose by hand, put a random value here.
SECRET_KEY=change-me-to-a-random-value

# ----------------------------------------------------------------- Runtime --
ENVIRONMENT=debug
K8S_NAMESPACE=local

# ----------------------------------------------- Published ports (host side) --
# Offset from the defaults so the stack does not collide with a Postgres or
# Redis you already run. Services reach each other over the compose network and
# do not care about these; they exist so you can psql or redis-cli in.
UCODE_POSTGRES_PORT=5433
UCODE_REDIS_PORT=6380
UCODE_MINIO_PORT=9010
UCODE_MINIO_CONSOLE_PORT=9011

# ------------------------------------------------------------ Admin panel --
# Where the browser reaches the backends. These are baked into the page at
# container start, so they must be addresses the browser can resolve — not
# compose service names.
UCODE_ADMIN_PORT=3000
UCODE_API_URL=http://127.0.0.1:8000

# Optional. The MAP and POLYGON field editors use Yandex Maps, which needs a
# key of your own — the key is public by nature (the browser sees it) but it is
# billed to whoever issued it, so ucode ships without one. Leave it empty and
# those two editors say maps are not configured; everything else works.
# Get one at https://developer.tech.yandex.ru/services (JavaScript API).
UCODE_YANDEX_MAPS_API_KEY=
UCODE_AUTH_URL=http://127.0.0.1:9104
