# syntax=docker/dockerfile:1

# The admin panel, built once and configured at container start.
#
# Vite inlines import.meta.env at build time, so a normal build would freeze one
# installation's API URLs into the bundle. Instead the build uses sentinels and
# the entrypoint rewrites them, which keeps a single published image usable
# everywhere.

FROM node:22-alpine AS builder

RUN corepack enable

WORKDIR /src

COPY apps/admin/package.json apps/admin/pnpm-lock.yaml ./
# react18 is a file: dependency, so its manifest has to exist before install.
COPY apps/admin/vendor/ ./vendor/
COPY apps/admin/packages/ ./packages/
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

COPY apps/admin/ ./

# Sentinels, not real URLs: see the entrypoint.
ENV VITE_API_URL=__UCODE_API_URL__
ENV VITE_AUTH_URL=__UCODE_AUTH_URL__
ENV VITE_CDN_URL=__UCODE_CDN_URL__
ENV VITE_ICON_CDN_URL=__UCODE_ICON_CDN_URL__

RUN pnpm run build

FROM nginx:1.27-alpine

COPY --from=builder /src/dist /usr/share/nginx/html
COPY deploy/admin-nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/admin-entrypoint.sh /docker-entrypoint.d/40-ucode-config.sh

RUN chmod +x /docker-entrypoint.d/40-ucode-config.sh

EXPOSE 80
